# Copy to .env and adjust. Never commit the real .env.

# --- Runtime ---
GABRIELLA_ENV=dev                 # dev | test | prod
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database (host-side URL; containers override the host to `db`) ---
POSTGRES_USER=gabriella
POSTGRES_PASSWORD=gabriella
POSTGRES_DB=gabriella
DB_HOST_PORT=5544
DATABASE_URL=postgresql+asyncpg://gabriella:gabriella@localhost:5544/gabriella
TEST_DATABASE_URL=postgresql+asyncpg://gabriella:gabriella@localhost:5544/gabriella_test

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false               # set true behind HTTPS

# --- Ports ---
API_HOST_PORT=8010
WEB_HOST_PORT=3000
REDIS_HOST_PORT=6390

# --- Retrieval ---
EMBEDDING_BACKEND=clip            # clip (CLIP ViT-B/32 via fastembed) | hashing (tests/CI)
REDIS_URL=redis://localhost:6390/0

# --- Seed accounts (local demo only) ---
SEED_ADMIN_EMAIL=admin@gabriella.example
SEED_ADMIN_PASSWORD=gabriella-admin
SEED_DEMO_EMAIL=demo@gabriella.example
SEED_DEMO_PASSWORD=gabriella-demo

# --- Gabriella's chat model (all free options are open-weight models) ---
# auto: Groq if GROQ_API_KEY is set, else Anthropic if ANTHROPIC_API_KEY is set,
# else the deterministic rule-based stylist (no model; same grounding checks).
LLM_PROVIDER=auto                  # auto | groq | ollama | openai_compatible | anthropic | none

# Groq (free key at https://console.groq.com/keys, no card): open-weight models, very fast.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b      # or qwen/qwen3.8-27b; run the models check in the README to see your account's list
LLM_REASONING_EFFORT=medium        # low | medium | high (gpt-oss): medium avoids most missed tool calls

# Ollama (fully local and offline). Install Ollama, `ollama pull qwen2.5:7b`, set LLM_PROVIDER=ollama.
# Defaults: host.docker.internal inside Docker, localhost when running the API directly.
# OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b            # qwen2.5:3b is faster on GPUs with 4 GB or less

# Any other OpenAI-compatible server (OpenRouter, vLLM, LM Studio), with LLM_PROVIDER=openai_compatible.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Anthropic Claude (paid API).
ANTHROPIC_API_KEY=
GABRIELLA_MODEL=claude-sonnet-5-5
GABRIELLA_EFFORT=low               # low | medium | high
